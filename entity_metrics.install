<?php

/**
 * @file
 * Install file for the Entity Metrics.
 */

use Drupal\Core\Database\Database;

/**
 * Implements hook_install().
 */
function entity_metrics_install() {
  $schema = [
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'entity_type' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
      ],
      'entity_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'timestamp' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'session_id' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
      ],
      'ip_address' => [
        'type' => 'varchar',
        'length' => 45,
      ],
      'region_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
      ],
      'geolocation_status' => [
        'description' => '0 pending, 1 located, 2 unknown.',
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ],
      'cookie_set' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'entity' => ['entity_type', 'entity_id'],
      'timestamp' => ['timestamp'],
      'geolocation_pending' => ['geolocation_status', 'id'],
    ],
    'foreign keys' => [
      'region_id' => [
        'table' => 'entity_metrics_regions',
        'columns' => ['region_id'],
        'references' => ['id'],
      ],
    ],
  ];

  Database::getConnection()->schema()->createTable('entity_metrics_data', $schema);

  $schema = [
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'location_key' => ['type' => 'varchar', 'length' => 64],
      'country' => [
        'type' => 'varchar',
        'length' => 255,
      ],
      'region' => [
        'type' => 'varchar',
        'length' => 255,
      ],
      'city' => [
        'type' => 'varchar',
        'length' => 255,
      ],
      'latitude' => [
        'type' => 'numeric',
        'precision' => 10,
        'scale' => 8,
      ],
      'longitude' => [
        'type' => 'numeric',
        'precision' => 11,
        'scale' => 8,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'country' => ['country'],
    ],
  ];

  $schema['unique keys']['location_key'] = ['location_key'];
  Database::getConnection()->schema()->createTable('entity_metrics_regions', $schema);
  foreach (entity_metrics_rollup_schema() as $table => $definition) {
    Database::getConnection()->schema()->createTable($table, $definition);
  }
}

/**
 * Implements hook_uninstall().
 */
function entity_metrics_uninstall() {
  Database::getConnection()->schema()->dropTable('entity_metrics_counts');
  Database::getConnection()->schema()->dropTable('entity_metrics_map');
  Database::getConnection()->schema()->dropTable('entity_metrics_data');
  Database::getConnection()->schema()->dropTable('entity_metrics_regions');
}

/**
 * Add cookie_set field.
 */
function entity_metrics_update_10001() {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('entity_metrics_data')) {
    return;
  }
  if ($schema->fieldExists('entity_metrics_data', 'cookie_set')) {
    return;
  }
  $schema->addField('entity_metrics_data', 'cookie_set', [
    'type' => 'int',
    'size' => 'tiny',
    'not null' => TRUE,
    'default' => 0,
  ]);
}

/**
 * Adds resumable geolocation state and indexed region lookup.
 */
function entity_metrics_update_10002(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->fieldExists('entity_metrics_data', 'geolocation_status')) {
    $schema->addField('entity_metrics_data', 'geolocation_status', [
      'description' => '0 pending, 1 located, 2 unknown.',
      'type' => 'int',
      'size' => 'tiny',
      'not null' => TRUE,
      'default' => 0,
    ]);
  }
  if (!$schema->indexExists('entity_metrics_data', 'geolocation_pending')) {
    $schema->addIndex('entity_metrics_data', 'geolocation_pending', ['geolocation_status', 'id'], [
      'fields' => [
        'geolocation_status' => ['type' => 'int', 'size' => 'tiny'],
        'id' => ['type' => 'serial', 'unsigned' => TRUE],
      ],
    ]);
  }
  if (!$schema->fieldExists('entity_metrics_regions', 'location_key')) {
    $schema->addField('entity_metrics_regions', 'location_key', ['type' => 'varchar', 'length' => 64]);
    $schema->addUniqueKey('entity_metrics_regions', 'location_key', ['location_key']);
  }
  $config = \Drupal::configFactory()->getEditable('entity_metrics.settings');
  foreach ([
    'geolocation_enabled' => FALSE,
    'geolocation_database' => 'private://GeoLite2-City.mmdb',
    'geolocation_batch_size' => 500,
  ] as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
    }
  }
  $config->save();
}

/**
 * Removes the IP index unless the optional rate limiter owns it.
 */
function entity_metrics_update_10003(): void {
  $schema = \Drupal::database()->schema();
  if (!\Drupal::moduleHandler()->moduleExists('entity_metrics_ratelimiter')
    && $schema->indexExists('entity_metrics_data', 'ip_timestamp')) {
    $schema->dropIndex('entity_metrics_data', 'ip_timestamp');
  }
}

/**
 * Creates summary tables without changing or deleting existing events.
 */
function entity_metrics_update_10004(): void {
  $schema = \Drupal::database()->schema();
  foreach (entity_metrics_rollup_schema() as $table => $definition) {
    if (!$schema->tableExists($table)) {
      $schema->createTable($table, $definition);
    }
  }
}

/**
 * Defines the retained count and map summaries for installs and upgrades.
 */
function entity_metrics_rollup_schema(): array {
  $entity_fields = [
    'entity_type' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE],
    'entity_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
  ];
  $count = ['type' => 'int', 'size' => 'big', 'unsigned' => TRUE, 'not null' => TRUE];
  return [
    'entity_metrics_counts' => [
      'fields' => $entity_fields + [
        'cookie_set' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE],
        'granularity' => ['type' => 'varchar', 'length' => 5, 'not null' => TRUE],
        'period' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
        'event_count' => $count,
      ],
      'primary key' => ['entity_type', 'entity_id', 'cookie_set', 'granularity', 'period'],
      'indexes' => ['aging' => ['granularity', 'period']],
    ],
    'entity_metrics_map' => [
      'fields' => $entity_fields + [
        'region_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
        'event_count' => $count,
        'last_timestamp' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      ],
      'primary key' => ['entity_type', 'entity_id', 'region_id'],
    ],
  ];
}
