<?php

/**
 * @file
 * Contains entity_metrics.module.
 */

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\StreamWrapper\StreamWrapperManager;

/**
 * Implements hook_help().
 */
function entity_metrics_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    // Main module help for the entity_metrics module.
    case 'help.page.entity_metrics':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('My Awesome Module') . '</p>';
      return $output;

    default:
  }
}

/**
 * Implements hook_preprocess_HOOK() for node templates.
 */
function entity_metrics_preprocess_node(&$variables) {
  // Check if the current page is a node view.
  if (\Drupal::routeMatch()->getRouteName() === 'entity.node.canonical') {
    $variables['#attached']['library'][] = 'entity_metrics/record';
  }
}

/**
 * Implements hook_file_download().
 */
function entity_metrics_file_download($uri) {
  $scheme = StreamWrapperManager::getScheme($uri);
  if ($scheme == 'fedora') {
    $request = \Drupal::requestStack()->getCurrentRequest();
    // Count whole-file requests only, excluding every partial-content request.
    if ($request->headers->has('Range')) {
      return NULL;
    }
    $ip = $request->getClientIp();
    $first_octet = substr($ip, 0, 3);
    // Do not record metrics on internal networking requests.
    if (in_array($first_octet, ['127', '172', '192'])) {
      return NULL;
    }

    $query = 'SELECT COALESCE(ma.entity_id, md.entity_id, mf.entity_id, mi.entity_id, mv.entity_id) AS mid from file_managed f
      LEFT JOIN media__field_media_audio_file ma ON field_media_audio_file_target_id = f.fid
      LEFT JOIN media__field_media_document md ON field_media_document_target_id = f.fid
      LEFT JOIN media__field_media_file mf ON field_media_file_target_id = f.fid
      LEFT JOIN media__field_media_image mi ON field_media_image_target_id = f.fid
      LEFT JOIN media__field_media_video_file mv ON field_media_video_file_target_id = f.fid
      WHERE uri = :uri';
    $mid = \Drupal::database()->query($query, [
      ':uri' => $uri,
    ])->fetchField();
    if ($mid) {
      $config = \Drupal::config('entity_metrics.settings');
      $cookieName = $config->get('cookie');
      \Drupal::database()->insert('entity_metrics_data')
        ->fields([
          'entity_type' => 'media',
          'entity_id' => $mid,
          'session_id' => \Drupal::service('session_manager')->getId(),
          'timestamp' => \Drupal::time()->getCurrentTime(),
          'ip_address' => $ip,
          'cookie_set' => $cookieName && \Drupal::request()->cookies->get($cookieName) === '1' ? '1' : '0',
        ])
        ->execute();
    }
  }

  return NULL;
}

/**
 * Implements hook_cron().
 */
function entity_metrics_cron(): void {
  if (!\Drupal::config('entity_metrics.settings')->get('geolocation_enabled')) {
    return;
  }
  try {
    $limit = (int) \Drupal::config('entity_metrics.settings')->get('geolocation_batch_size');
    \Drupal::service('entity_metrics.geolocation')->process($limit ?: 500);
  }
  catch (\Throwable $exception) {
    // Neither IP addresses nor visitor identifiers belong in operational logs.
    \Drupal::logger('entity_metrics')->error('Local geolocation failed: @message', ['@message' => $exception->getMessage()]);
  }
}

/**
 * Implements hook_page_bottom().
 */
function entity_metrics_page_bottom(array &$page_bottom): void {
  $page_bottom['entity_metrics_attribution']['#cache']['tags'][] = 'config:entity_metrics.settings';
  if (\Drupal::config('entity_metrics.settings')->get('geolocation_enabled')) {
    $page_bottom['entity_metrics_attribution'] = [
      '#markup' => t('This product includes GeoLite2 data created by MaxMind, available from <a href=":url">MaxMind</a>.', [':url' => 'https://www.maxmind.com']),
      '#cache' => ['tags' => ['config:entity_metrics.settings']],
    ];
  }
}
